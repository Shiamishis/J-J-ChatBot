    JOIN DIM_Time T ON F.time_id = T.time_id
    WHERE T.year = 2025
    GROUP BY 1, 2, 3, 4
),
Account_Metrics_Agg AS (
    SELECT 
        F.brand_id,
        F.account_id,
        F.time_id,
        F.target_class,
        COALESCE(F.rx_volume_monthly, 0) as rx_volume_monthly
    FROM FACT_Account_Metrics F
