[ID 53] Testing: Correlation between coverage rate and revenue by brand in 2025
Determined intent: data_handler
Instantiated handler: DataHandler
[DataHandler] Tables identified: {'DIM_Brand', 'FACT_Coverage', 'FACT_Sales'}
[DataHandler] SQL Generated: WITH Coverage_Agg AS (
    SELECT 
        F.brand_id, 
        SUM(F.kpi002_target_coverage_pct) as total_coverage
    FROM FACT_Coverage F
    JOIN DIM_Time T ON F.time_id = T.time_id
    WHERE T.year = 2025
    GROUP BY 1
),
Sales_Agg AS (
    SELECT 
        F.brand_id, 
        SUM(F.net_revenue_eur) as total_revenue
    FROM FACT_Sales F
    JOIN DIM_Time T ON F.time_id = T.time_id
    WHERE T.year = 2025
    GROUP BY 1
)
SELECT 
    D.brand_name, 
    (COALESCE(CA.total_coverage, 0) * COALESCE(SA.total_revenue, 0)) / 
    (SQRT(SUM(CA.total_coverage * CA.total_coverage) OVER ()) * 
     SQRT(SUM(SA.total_revenue * SA.total_revenue) OVER ())) as correlation
