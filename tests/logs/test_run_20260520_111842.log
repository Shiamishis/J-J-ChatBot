[DataHandler] SQL Generated: WITH 
  -- Filter FACT_Targets for FY2025-Q1
  targets AS (
    SELECT 
      t.geo_id,
      t.brand_id,
      t.target_value,
      t.target_type
    FROM 
      FACT_Targets t
    JOIN 
      DIM_Time dt ON t.time_id = dt.time_id
    WHERE 
      dt.fiscal_quarter = 'FY2025-Q1'
  ),
  
  -- Filter FACT_KPI_Summary for FY2025-Q1
  kpi_summary AS (
    SELECT 
      ks.geo_id,
      ks.brand_id,
      ks.kpi_name,
      ks.kpi_value,
      ks.target_value
    FROM 
      FACT_KPI_Summary ks
    JOIN 
      DIM_Time dt ON ks.time_id = dt.time_id
    WHERE 
      dt.fiscal_quarter = 'FY2025-Q1'
  )

-- Join targets and kpi_summary with DIM_Geography and DIM_Brand
SELECT 
  dg.geo_name AS country,
  db.brand_name AS brand,
  t.target_type,
  t.target_value,
  ks.kpi_name,
  ks.kpi_value,
  ks.target_value AS kpi_target
FROM 
  targets t
JOIN 
  DIM_Geography dg ON t.geo_id = dg.geo_id
JOIN 
  DIM_Brand db ON t.brand_id = db.brand_id
JOIN 
  kpi_summary ks ON t.geo_id = ks.geo_id AND t.brand_id = ks.brand_id
ORDER BY 
  country, brand, target_type;
