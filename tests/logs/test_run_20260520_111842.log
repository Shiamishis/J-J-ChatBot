[ID 6] Testing: Year-over-year revenue growth percentage by brand in 2025
Determined intent: data_handler
Instantiated handler: DataHandler
[DataHandler] Tables identified: {'FACT_Sales', 'DIM_Time', 'FACT_Interactions', 'DIM_Brand'}
[DataHandler] SQL Generated: WITH 
  -- Calculate revenue for each brand in 2024 and 2025
  brand_revenue AS (
    SELECT 
      fs.brand_id,
      dt.year,
      SUM(fs.net_revenue_eur) AS total_revenue
    FROM 
      FACT_Sales fs
    JOIN 
      DIM_Time dt ON fs.time_id = dt.time_id
    WHERE 
      dt.year IN (2024, 2025)
    GROUP BY 
      fs.brand_id, dt.year
  ),
  
  -- Calculate year-over-year revenue growth percentage for each brand
  brand_growth AS (
    SELECT 
      br.brand_id,
      br.year,
      br.total_revenue,
      LAG(br.total_revenue) OVER (PARTITION BY br.brand_id ORDER BY br.year) AS prev_year_revenue,
      ((br.total_revenue - LAG(br.total_revenue) OVER (PARTITION BY br.brand_id ORDER BY br.year)) / 
       LAG(br.total_revenue) OVER (PARTITION BY br.brand_id ORDER BY br.year)) * 100 AS yoy_growth_pct
    FROM 
      brand_revenue br
  )

-- Filter for 2025 and join with DIM_Brand to get brand names
SELECT 
  db.brand_name,
  bg.yoy_growth_pct
