    DIM_Geography DG ON FSM.account_id IN (SELECT account_id FROM DIM_Account DA WHERE DA.country_code = DG.country_code)
JOIN 
    DIM_Time DT ON FSM.time_id = DT.time_id
WHERE 
    DT.year = 2025 AND FSM.sample_status = 'DELIVERED'
GROUP BY 
    DG.country_code
