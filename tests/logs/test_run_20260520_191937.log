[DataHandler] SQL Generated: SELECT 
    DG.country_code,
    SUM(CASE WHEN FSM.signature_collected = 1 THEN 1 ELSE 0 END) AS signature_count,
    SUM(CASE WHEN FSM.requires_signature = 1 THEN 1 ELSE 0 END) AS total_signature_required,
    ROUND(SUM(CASE WHEN FSM.signature_collected = 1 THEN 1 ELSE 0 END) * 1.0 / 
          SUM(CASE WHEN FSM.requires_signature = 1 THEN 1 ELSE 0 END), 2) AS compliance_rate
