[DataHandler] SQL Generated: SELECT 
    DG.geo_name AS Country,
    DB.brand_name AS Brand,
    SUM(FS.net_revenue_eur) AS Revenue,
    FT.target_value AS Target
FROM 
    FACT_Sales FS
JOIN 
    DIM_Geography DG ON FS.geo_id = DG.geo_id
JOIN 
    DIM_Brand DB ON FS.brand_id = DB.brand_id
JOIN 
    FACT_Targets FT ON FS.brand_id = FT.brand_id AND FS.geo_id = FT.geo_id
JOIN 
    DIM_Time DT ON FS.time_id = DT.time_id
WHERE 
    DT.fiscal_year = 'FY2025'
GROUP BY 
    DG.geo_name, DB.brand_name, FT.target_value
ORDER BY 
    Country, Brand;
