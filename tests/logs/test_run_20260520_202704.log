[ID 45] Testing: Market share targets vs. actual market share by brand in 2025
Determined intent: data_handler
Instantiated handler: DataHandler
[DataHandler] Tables identified: {'DIM_Time', 'DIM_Brand', 'FACT_Interactions', 'FACT_Targets', 'FACT_Sales'}
[DataHandler] SQL Generated: WITH Actual_Market_Share_Agg AS (
    SELECT 
        F.brand_id, 
        SUM(F.market_share_pct) as actual_market_share
    FROM FACT_Sales F
    JOIN DIM_Time T ON F.time_id = T.time_id
    WHERE T.year = 2025
    GROUP BY 1
),
Target_Market_Share_Agg AS (
    SELECT 
        F.brand_id, 
        SUM(F.target_value) as target_market_share
    FROM FACT_Targets F
    JOIN DIM_Time T ON F.time_id = T.time_id
    WHERE F.target_type = 'MARKET_SHARE_TARGET' AND T.year = 2025
    GROUP BY 1
)
SELECT 
    D.brand_name, 
    COALESCE(A.actual_market_share, 0) as actual_market_share, 
    COALESCE(T.target_market_share, 0) as target_market_share
FROM DIM_Brand D
LEFT JOIN Actual_Market_Share_Agg A ON D.brand_id = A.brand_id
LEFT JOIN Target_Market_Share_Agg T ON D.brand_id = T.brand_id
ORDER BY 2 DESC;
