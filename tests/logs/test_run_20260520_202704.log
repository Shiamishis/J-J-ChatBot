  D.brand_name, 
  COALESCE(S2.total_revenue_2025, 0) as total_revenue_2025,
  COALESCE(S1.total_revenue_2024, 0) as total_revenue_2024,
  ROUND(((COALESCE(S2.total_revenue_2025, 0) - COALESCE(S1.total_revenue_2024, 0)) / COALESCE(S1.total_revenue_2024, 0)) * 100, 2) as yoy_growth_pct
