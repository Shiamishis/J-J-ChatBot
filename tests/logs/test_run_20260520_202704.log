[ID 52] Testing: Revenue per interaction by brand and country in 2025 (sales efficiency)
Determined intent: data_handler
Instantiated handler: DataHandler
[DataHandler] Tables identified: {'DIM_Geography', 'DIM_Time', 'FACT_Interactions', 'DIM_Brand', 'FACT_Sales'}
[DataHandler] SQL Generated: WITH Sales_Agg AS (
    SELECT 
        G.geo_id, 
        G.country_code, 
        B.brand_id, 
        SUM(COALESCE(S.net_revenue_eur, 0)) as total_revenue
    FROM FACT_Sales S
    JOIN DIM_Geography G ON S.geo_id = G.geo_id
    JOIN DIM_Brand B ON S.brand_id = B.brand_id
    JOIN DIM_Time T ON S.time_id = T.time_id
    WHERE T.year = 2025
    GROUP BY 1, 2, 3
),
Interactions_Agg AS (
    SELECT 
        G.geo_id, 
        G.country_code, 
        B.brand_id, 
        SUM(COALESCE(I.interaction_duration_min, 0)) as total_interactions
    FROM FACT_Interactions I
    JOIN DIM_Geography G ON I.geo_id = G.geo_id
    JOIN DIM_Brand B ON I.brand_id = B.brand_id
    JOIN DIM_Time T ON I.time_id = T.time_id
    WHERE T.year = 2025
    GROUP BY 1, 2, 3
)
SELECT 
    D.brand_name, 
    G.country_code, 
    COALESCE(S.total_revenue, 0) / COALESCE(I.total_interactions, 1) as revenue_per_interaction
FROM DIM_Brand D
JOIN DIM_Geography G ON G.geo_id = D.geo_id
LEFT JOIN Sales_Agg S ON D.brand_id = S.brand_id AND G.geo_id = S.geo_id
LEFT JOIN Interactions_Agg I ON D.brand_id = I.brand_id AND G.geo_id = I.geo_id
ORDER BY 3 DESC;
