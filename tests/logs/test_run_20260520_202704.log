[ID 55] Testing: Sample delivery rate per interaction by brand in 2025
Determined intent: data_handler
Instantiated handler: DataHandler
[DataHandler] Tables identified: {'FACT_Sample_Management', 'DIM_Time', 'DIM_Brand', 'FACT_Interactions'}
[DataHandler] SQL Generated: WITH Sample_Delivery_Agg AS (
    SELECT 
        FSM.brand_id, 
        SUM(CASE WHEN FSM.sample_status = 'DELIVERED' THEN FSM.sample_quantity ELSE 0 END) as total_samples_delivered
    FROM FACT_Sample_Management FSM
    JOIN DIM_Time DT ON FSM.time_id = DT.time_id
    WHERE DT.year = 2025
    GROUP BY 1
),
Interaction_Agg AS (
    SELECT 
        FI.brand_id, 
        COUNT(FI.interaction_id) as total_interactions
    FROM FACT_Interactions FI
    JOIN DIM_Time DT ON FI.time_id = DT.time_id
    WHERE DT.year = 2025
    GROUP BY 1
)
SELECT 
    DB.brand_name, 
    COALESCE(SDA.total_samples_delivered, 0) / COALESCE(IA.total_interactions, 1) as sample_delivery_rate
FROM DIM_Brand DB
LEFT JOIN Sample_Delivery_Agg SDA ON DB.brand_id = SDA.brand_id
LEFT JOIN Interaction_Agg IA ON DB.brand_id = IA.brand_id
ORDER BY sample_delivery_rate DESC;
