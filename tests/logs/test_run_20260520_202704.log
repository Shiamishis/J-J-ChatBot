[ID 53] Testing: Correlation between coverage rate and revenue by brand in 2025
Determined intent: data_handler
Instantiated handler: DataHandler
[DataHandler] Tables identified: {'FACT_Coverage', 'DIM_Time', 'FACT_Interactions', 'DIM_Brand', 'FACT_Sales'}
[DataHandler] SQL Generated: WITH Coverage_Agg AS (
    SELECT 
        F.brand_id, 
        T.year, 
        AVG(F.kpi002_target_coverage_pct) as avg_coverage_rate
    FROM FACT_Coverage F
    JOIN DIM_Time T ON F.time_id = T.time_id
    GROUP BY 1, 2
),
Revenue_Agg AS (
    SELECT 
        F.brand_id, 
        T.year, 
        SUM(F.net_revenue_eur) as total_revenue
    FROM FACT_Sales F
    JOIN DIM_Time T ON F.time_id = T.time_id
    GROUP BY 1, 2
)
SELECT 
    D.brand_name, 
    C.avg_coverage_rate, 
    R.total_revenue,
    (C.avg_coverage_rate * R.total_revenue) / (COALESCE(C.avg_coverage_rate, 0) * COALESCE(R.total_revenue, 0) + 1e-10) as correlation
FROM DIM_Brand D
LEFT JOIN Coverage_Agg C ON D.brand_id = C.brand_id AND C.year = 2025
LEFT JOIN Revenue_Agg R ON D.brand_id = R.brand_id AND R.year = 2025
ORDER BY correlation DESC;
